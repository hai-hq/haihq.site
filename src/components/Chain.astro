---
interface Step {
  label: string;
  text: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="chain">
  {steps.map((step, index) => (
    <li>
      <span class="chain-index" aria-hidden="true">
        {String(index + 1).padStart(2, "0")}
      </span>
      <span class="chain-label">{step.label}</span>
      <p>{step.text}</p>
    </li>
  ))}
</ol>
