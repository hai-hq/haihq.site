---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found"
  description="The address does not match a page on HAIHQ."
  path="/404"
  noindex
>
  <main class="hero">
    <div class="wrap hero-copy">
      <p class="kicker">HAIHQ / 404</p>
      <h1>This page is not on the site.</h1>
      <p class="lede">The address does not match a page.</p>
      <a class="btn btn-primary" href="/">
        Back to home
      </a>
    </div>
  </main>
</Base>
